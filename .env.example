# TechHub Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env to version control.
# Lists exactly the variables docker-compose.yaml reads; values after ":-" in compose are defaults.

# PostgreSQL (one user for all five databases)
DB_USER=postgres
DB_PASSWORD=changeme
PRODUCTS_DB_NAME=products_db
INVENTORY_DB_NAME=inventory_db
ORDERS_DB_NAME=orders_db
AUTH_DB_NAME=auth_db
# Shared by audit-service and notification-service
LOGGING_DB_NAME=logging_db

# Django (product, inventory, order)
DJANGO_SECRET_KEY=changeme-to-a-secure-random-string
INVENTORY_DJANGO_SECRET_KEY=changeme-to-a-secure-random-string
ORDERS_DJANGO_SECRET_KEY=changeme-to-a-secure-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,product-service,inventory-service,order-service,gateway,frontend

# Service URLs (inside the compose network)
PRODUCT_SERVICE_URL=http://product-service:8000
INVENTORY_SERVICE_URL=http://inventory-service:8001
# order-service -> inventory-service calls without a signed-in user (guests, Stripe webhook); openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=changeme-to-a-secure-random-string
API_GATEWAY_URL=http://gateway:8080/api

# Gateway: extra allowed CORS origins (localhost is always allowed)
CORS_ORIGINS=http://localhost,http://localhost:3000

# Auth (Better Auth)
AUTH_PORT=3001
BETTER_AUTH_SECRET=changeme-to-a-secure-random-string
BETTER_AUTH_URL=http://localhost/auth
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info
# Seeded as admin on auth-service start if no admin exists yet; also receives low-stock emails
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_NAME=Admin
# Demo cashier/warehouse/customer accounts (@techhub.local, password123). Always seeded outside production;
# with NODE_ENV=production only when this is true (staging). Never set it on prod.
SEED_DEMO_USERS=

# OAuth (optional — leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3001/auth/callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:3001/auth/callback/github

# RabbitMQ
RABBITMQ_USER=techhub
RABBITMQ_PASSWORD=changeme
RABBITMQ_URL=amqp://techhub:changeme@rabbitmq:5672/

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_AUTH_URL=http://localhost/auth
PROXY_AUTH_URL=http://gateway:8080/auth
NODE_ENV=development

# Stripe (optional — leave blank to disable payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email: SMTP wins over Resend when SMTP_HOST is set; with neither, emails are only logged.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<16-char app password>
# (needs 2-Step Verification). Port 465 uses SSL, 587 STARTTLS. SMTP_FROM defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Email via Resend (sends to anyone only from a verified domain you own; free public domains like *.pp.ua are refused)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Monitoring (Grafana on 127.0.0.1:GRAFANA_PORT; use different ports for staging and prod on one host)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3002
